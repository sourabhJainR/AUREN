      ],
      "approval_boundary": "Frontend changes remain subject to assigned path scope, API contracts, QA and security review."
    },
    {
      "id": "DATA-01",
      "title": "Data Integration Engineer Agent",
      "reports_to": "EM-ENG-01",
      "expertise": [
        "provider_adapters",
        "data_quality",
        "provenance"
      ],
      "accountable_for": [
        "typed provider adapters",
