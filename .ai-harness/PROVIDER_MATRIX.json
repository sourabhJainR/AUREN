{
  "schema_version": 1,
  "principle": "AUREN owns orchestration semantics; providers supply inference and native capabilities",
  "providers": {
    "claude": {
      "surfaces": ["claude-code-cli", "claude-code-ide", "claude-code-desktop", "claude-code-web"],
      "instruction_files": ["CLAUDE.md", ".claude/skills/ai-coding-orchestrator/SKILL.md"],
      "optional_mechanisms": ["hooks", "MCP", "subagents"],
      "command_template": ["{python}", ".ai-harness/safe_provider.py", "--prompt-file", "{prompt_file}", "--", "claude", "-p"],
      "native_context_is_jit": true,
      "supports_local_execution": true,
      "chatgpt_surface": false
    },
    "codex": {
      "surfaces": ["codex-cli", "codex-ide", "codex-desktop", "codex-web"],
      "instruction_files": ["AGENTS.md", ".agents/skills/ai-coding-orchestrator/SKILL.md"],
      "optional_mechanisms": ["MCP", "plugins", "skills", "worktrees"],
      "command_template": ["{python}", ".ai-harness/safe_provider.py", "--prompt-file", "{prompt_file}", "--", "codex", "exec"],
      "native_context_is_jit": true,
      "supports_local_execution": true,
      "chatgpt_surface": true
    },
    "gemini": {
      "surfaces": ["gemini-cli", "gemini-code-assist", "antigravity"],
      "instruction_files": ["GEMINI.md", "AGENTS.md", ".gemini/agents/"],
      "optional_mechanisms": ["extensions", "MCP", "A2A", "custom-commands"],
      "command_template": ["{python}", ".ai-harness/safe_provider.py", "--prompt-file", "{prompt_file}", "--", "gemini", "-p"],
      "native_context_is_jit": true,
      "supports_local_execution": true,
      "chatgpt_surface": false,
      "migration_aliases": ["antigravity"]
    },
    "chatgpt": {
      "surfaces": ["chatgpt", "chatgpt-project", "codex-in-chatgpt", "openai-api"],
      "instruction_files": ["AGENTS.md"],
      "optional_mechanisms": ["MCP", "apps", "plugins", "skills", "containers"],
      "command_template": null,
      "native_context_is_jit": false,
      "supports_local_execution": false,
      "execution_transport": "MCP_or_codex_surface",
      "important": "Do not model ordinary ChatGPT chat as a local subprocess provider. Use Codex in ChatGPT, an approved MCP app, or the API when execution is required."
    }
  },
  "normalized_contract": [
    "intent_digest",
    "goal",
    "boundaries",
    "acceptance",
    "risk",
    "capability_plan",
    "context_lease_digests",
    "tool_observations",
    "verification_evidence",
    "outcome"
  ]
}
