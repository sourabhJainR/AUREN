# Public MCP endpoint. DNS must point this name to the Docker host.
AUREN_MCP_DOMAIN=mcp.example.com
AUREN_PROJECT_HOST_PATH=/srv/auren/project

# Exact canonical resource and authorization-server issuer URIs.
AUREN_MCP_RESOURCE_URL=https://mcp.example.com/mcp
AUREN_MCP_AUTHORIZATION_SERVER=https://identity.example.com/
AUREN_MCP_INTROSPECTION_URL=https://identity.example.com/oauth/introspect
AUREN_MCP_INTROSPECTION_CLIENT_ID=auren-mcp-resource-server
AUREN_MCP_INTROSPECTION_CLIENT_SECRET=replace-with-a-secret-from-your-secret-manager

# Incoming request boundaries. Keep this list limited to the MCP hostname.
AUREN_MCP_ALLOWED_HOSTS=mcp.example.com
AUREN_MCP_ALLOWED_ORIGINS=https://chatgpt.com

# Optional provider/model credentials belong here only if the selected AUREN
# runtime providers require them. Prefer secret-manager injection.
