# Optional manual fallback. Prefer `auren up --project-root <path>`, which
# discovers the shared Codex/ChatGPT desktop config, writes the real paths and
# local MCP port, and makes a backup before changing an existing config.
# Merge this section only if you are configuring the client manually.
# Replace the three C:/Path/... values. No OAuth or bearer token is stored here.

[mcp_servers.auren]
command = "C:/Path/To/Python/python.exe"
args = [
  "C:/Path/To/AUREN/auren_cli.py",
  "mcp-proxy",
  "--url", "http://127.0.0.1:8765/mcp",
  "--token-file", "C:/Users/YourUser/.auren/mcp/local-operator.token",
]
cwd = "C:/Path/To/AUREN"
