# Merge this section into %USERPROFILE%\\.codex\\config.toml (Windows)
# or ~/.codex/config.toml (macOS/Linux). Do not overwrite existing MCP entries.
# ChatGPT desktop, Codex app, CLI and IDE extension share this configuration.
# Local stdio mode requires no OAuth and does not store the local bearer token here.

[mcp_servers.auren]
command = "C:\\Python\\python.exe"
args = [
  "C:\\Work\\AUREN\\auren_cli.py",
  "mcp-proxy",
  "--url", "http://127.0.0.1:8765/mcp",
  "--token-file", "C:\\Users\\<user>\\.auren\\mcp\\local-operator.token",
]
cwd = "C:\\Work\\AUREN"
