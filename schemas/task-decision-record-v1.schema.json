{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourabhjainr.github.io/AUREN/schemas/task-decision-record-v1.json",
  "title": "AUREN Task Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "repository",
    "base_commit",
    "head_commit",
    "risk_level",
    "acceptance_criteria",
    "selected_option",
    "selection_rationale",
    "alternatives",
    "dependencies",
    "checks",
    "limitations",
    "rollback_trigger",
    "rollback_action",
    "retry_history",
    "promotion"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selected_option": {
      "type": "string",
      "minLength": 1
    },
    "selection_rationale": {
      "type": "string",
      "minLength": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option",
          "reason_rejected"
        ],
        "properties": {
          "option": {
            "type": "string",
            "minLength": 1
          },
          "reason_rejected": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "status",
          "commit_sha",
          "evidence_id",
          "evaluator_type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "unknown"
            ]
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "evaluator_type": {
            "enum": [
              "internal",
              "independent",
              "external"
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rollback_trigger": {
      "type": "string",
      "minLength": 1
    },
    "rollback_action": {
      "type": "string",
      "minLength": 1
    },
    "retry_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis",
          "strategy",
          "new_evidence_ids"
        ],
        "properties": {
          "hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "strategy": {
            "type": "string",
            "minLength": 1
          },
          "new_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "enum": [
            "none",
            "provisional",
            "verified_for_scope",
            "repeatedly_reliable",
            "independently_corroborated"
          ]
        },
        "approved_by": {
          "type": "string"
        },
        "approval_evidence_id": {
          "type": "string"
        },
        "external_evaluator_id": {
          "type": "string"
        },
        "corpus_owner_id": {
          "type": "string"
        },
        "receipt_digest": {
          "type": "string"
        },
        "repeat_run_id": {
          "type": "string"
        },
        "evaluator_control": {
          "enum": [
            "implementation_team",
            "separate_operator",
            "external"
          ]
        },
        "corpus_control": {
          "enum": [
            "implementation_team",
            "separate_operator",
            "external"
          ]
        }
      }
    },
    "last_known_good_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "risk_level": {
            "enum": [
              "high",
              "critical"
            ]
          }
        },
        "required": [
          "risk_level"
        ]
      },
      "then": {
        "required": [
          "last_known_good_commit"
        ]
      }
    }
  ]
}
